# Production Environment Variable Template
# Copy this file to .env.local for local development.
# Configure these variables in Netlify Site Settings > Environment Variables for Production.

# Supabase Public Configuration (Exposed to Vite Client)
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Mode Configuration (Optional)
# VITE_MOCK_FALLBACK_ALLOWED=true (Set to false or omit in production to strictly require Supabase)

# NEVER include SUPABASE_SERVICE_ROLE_KEY or database passwords in client bundles.
